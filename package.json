    "test:toolbox:001-limit": "playwright test tests/tool-001-limit.spec.ts --workers=1",
    "test:toolbox:002-limit": "playwright test tests/tool-002-limit.spec.ts --workers=1",
    "test:toolbox:003-limit": "playwright test tests/tool-003-limit.spec.ts --workers=1",
    "test:toolbox:004-limit": "playwright test tests/tool-004-limit.spec.ts --workers=1",
    "test:toolbox:005-limit": "playwright test tests/tool-005-limit.spec.ts --workers=1",
    "test:toolbox:001-005-limit": "playwright test tests/tool-001-limit.spec.ts tests/tool-002-limit.spec.ts tests/tool-003-limit.spec.ts tests/tool-004-limit.spec.ts tests/tool-005-limit.spec.ts --workers=1",
