    "test:toolbox:006-load": "playwright test tests/tool-006-load-limit.spec.ts --workers=1",
    "test:toolbox:001-load": "playwright test tests/tool-001-load-limit.spec.ts --workers=1",
    "test:toolbox:002-load": "playwright test tests/tool-002-load-limit.spec.ts --workers=1",
