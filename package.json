    "test:toolbox:007-fast": "playwright test tests/tool-007-web-image-optimizer.spec.ts --workers=1",
    "test:toolbox:007-final": "npm run build && npm run test:toolbox:007",
    "test:toolbox:001": "playwright test tests/tool-001-limit.spec.ts tests/tool-001-load-limit.spec.ts --workers=1",
    "test:toolbox:002": "playwright test tests/tool-002-limit.spec.ts tests/tool-002-load-limit.spec.ts --workers=1",
    "test:toolbox:003": "playwright test tests/tool-003-limit.spec.ts tests/tool-003-load-limit.spec.ts --workers=1",
    "test:toolbox:004": "playwright test tests/tool-004-image-compressor.spec.ts tests/tool-004-limit.spec.ts tests/tool-004-load-limit.spec.ts --workers=1",
