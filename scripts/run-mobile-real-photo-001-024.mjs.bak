#!/usr/bin/env node
import fs from 'fs';
import path from 'path';
import os from 'os';
import { spawnSync } from 'child_process';
import { _android as android } from 'playwright';

/*
  FIXLGS TOOLBOX 001~024 Android Chrome real-photo smoke validator
  - product code is never modified
  - real user flow only: open tool -> native picker -> gallery 4th photo -> immediate small scroll
  - one first-pass case per tool, one independent retest only for PRODUCT_FAIL
  - no product retry/fallback/recovery inside a case
  - HARNESS_FAIL is separated from PRODUCT_FAIL
*/

const args = parseArgs(process.argv);
const BASE = String(args['base-url'] || 'https://toolbox.fixlgs.com').replace(/\/$/, '');
const LOCALE = String(args.locale || 'ko');
const SAFETY_ATTACH_MS = numArg(args['attach-timeout'], 12000);
const SAFETY_RESULT_MS = numArg(args['result-timeout'], 18000);
const RETEST = args['no-retest'] ? false : true;
const PHOTO_SLOT = Math.max(1, numArg(args['photo-slot'], 4));
const ONLY = parseOnly(args.only);
const SCROLL_PX = numArg(args.scroll, 420);
const desktop = process.platform === 'win32' ? path.join(process.env.USERPROFILE || os.homedir(), 'Desktop') : os.homedir();
const stamp = new Date().toISOString().replace(/[-:TZ.]/g, '').slice(0, 14);
const outDir = path.join(desktop, `TOOLBOX_MOBILE_REALPHOTO_001_024_${stamp}`);
fs.mkdirSync(outDir, { recursive: true });

const TOOLS = [
  t(1,'jpg-png-webp-image-converter','[data-testid="converter-file-input"]',['[data-testid="converter-file-card"]'], '[data-testid="converter-run"]', ['[data-testid="converter-file-card"]']),
  t(2,'heic-avif-image-converter','[data-testid="heic-file-input"]',['[data-testid="heic-file-card"]'], '[data-testid="heic-run"]', ['[data-testid="heic-file-card"]']),
  t(3,'svg-bmp-tiff-image-converter','[data-testid="svg-file-input"]',['[data-testid="svg-file-card"]'], '[data-testid="svg-run"]', ['[data-testid="svg-file-card"]']),
  t(4,'image-compressor','[data-testid="compressor-file-input"]',['[data-testid="compressor-file-card"]'], '[data-testid="compressor-run"]', ['[data-testid="compressor-summary"]','[data-testid="compressor-zip"]']),
  t(5,'target-size-image-compressor','[data-testid="target-file-input"]',['[data-testid="target-file-card"]'], '[data-testid="target-compress-button"]', ['[data-testid="target-zip-button"]','[data-testid="target-file-card"]']),
  t(6,'image-resizer','[data-testid="resizer-file-input"]',['[data-testid="resizer-file-card"]'], '[data-testid="resizer-run"]', ['[data-testid="resizer-zip"]','[data-testid="resizer-file-card"]']),
  t(7,'web-image-optimizer','[data-testid="optimizer-file-input"]',['[data-testid="optimizer-file-card"]'], '[data-testid="optimizer-run"]', ['[data-testid="optimizer-summary"]','[data-testid="optimizer-zip"]']),
  t(8,'image-cropper-rotator','[data-testid="cropper-file-input"]',['[data-testid="cropper-stage"]','[data-testid="cropper-workbench"]'], /결과 확인|결과 만들기|적용|Preview Result|Apply/i, ['[data-testid="cropper-download-zip"]','[data-testid="cropper-stage"]']),
  t(9,'image-brightness-color-adjuster','input[type="file"]',['[data-testid="tool009-select"]','canvas'], null, ['canvas'], {uploadText:/이미지 선택|사진 선택|파일 선택/i}),
  t(10,'image-mosaic-blur-tool','input[type="file"]',['[data-testid="tool010-select"]','canvas'], null, ['canvas'], {uploadText:/이미지 선택|사진 선택|파일 선택/i}),
  t(11,'image-padding-background-tool','[data-testid="tool011-file"]',['[data-testid="tool011-canvas-wrap"]','[data-testid="tool011-status"]'], null, ['[data-testid="tool011-download"]','[data-testid="tool011-canvas-wrap"]']),
  t(12,'image-border-rounded-corners-tool','[data-testid="tool012-file"]',['[data-testid="tool012-editor"]','[data-testid="tool012-status"]'], null, ['[data-testid="tool012-download"]','[data-testid="tool012-output-size"]']),
  t(13,'image-merger','[data-testid="tool013-file-input"]',['[data-testid="tool013-preview"]'], null, ['[data-testid="tool013-preview"]'], {uploads:2}),
  t(14,'image-collage-maker','[data-testid="tool014-file-input"]',['[data-testid="tool014-layout-3x3"]','canvas'], null, ['canvas'], {uploads:2}),
  t(15,'before-after-image-maker','[data-testid="tool015-before-input"]',['[data-testid="tool015-before-label"]'], null, ['canvas','[data-testid="tool015-workbench"]'], {uploadSelectors:['[data-testid="tool015-before-input"]','[data-testid="tool015-after-input"]']}),
  t(16,'add-text-to-image','[data-testid="tool016-file-input"]',['[data-testid="tool016-layer"]','canvas'], null, ['canvas','[data-testid="tool016-layer"]']),
  t(17,'image-watermark-tool','[data-testid="tool017-input"]',['[data-testid="tool017-editor"]','canvas'], null, ['canvas']),
  t(18,'image-metadata-checker','[data-testid="tool018-input"]',['[data-testid="tool018-basic-info"]','[data-testid="tool018-file-item"]'], null, ['[data-testid="tool018-basic-info"]','[data-testid="tool018-batch-summary"]']),
  t(19,'youtube-thumbnail-maker','[data-testid="tool019-file-input"]',['[data-testid="tool019-filename"]','canvas'], null, ['canvas','[data-testid="tool019-resolution"]']),
  t(20,'youtube-channel-banner-maker','[data-testid="tool020-background-input"]',['[data-testid="tool020-root"]','canvas'], null, ['canvas','[data-testid="tool020-root"]']),
  t(21,'social-media-image-maker','[data-testid="tool021-background-input"]',['canvas'], null, ['canvas']),
  t(22,'blog-open-graph-image-maker','[data-testid="tool022-background-input"]',['[data-testid="tool-022-root"]','canvas'], null, ['[data-testid="tool022-download-current"]','canvas']),
  t(23,'app-icon-favicon-generator','[data-testid="tool023-file-input"]',['[data-testid="tool023-file-list"]','[data-testid="tool023-workspace-dropzone"]'], null, ['[data-testid="tool023-file-list"]','[data-testid="tool023-workspace-dropzone"]']),
  t(24,'app-store-screenshot-maker','[data-testid="tool024-dropzone"] input[type="file"], input[type="file"]',['[data-testid="tool024-preview"]','[data-testid="tool024-result-count"]'], null, ['[data-testid="tool024-export-zip"]','[data-testid="tool024-preview"]']),
].filter(x => !ONLY || ONLY.has(x.number));

function t(n,slug,input,attach,action,result,extra={}) { return {number:String(n).padStart(3,'0'), slug, input, attach, action, result, uploads:1, ...extra}; }
function parseArgs(argv){const o={};for(let i=2;i<argv.length;i++){const s=argv[i];if(!s.startsWith('--'))continue;const k=s.slice(2),n=argv[i+1];if(!n||n.startsWith('--'))o[k]=true;else{o[k]=n;i++;}}return o;}
function numArg(v,d){const n=Number(v);return Number.isFinite(n)&&n>=0?n:d;}
function parseOnly(v){if(!v)return null;const s=new Set();for(const p of String(v).split(',')){const m=p.trim().match(/^(\d+)(?:-(\d+))?$/);if(!m)continue;const a=+m[1],b=m[2]?+m[2]:a;for(let i=Math.min(a,b);i<=Math.max(a,b);i++)s.add(String(i).padStart(3,'0'));}return s;}
const sleep = ms => new Promise(r=>setTimeout(r,ms));
function adb(...a){return spawnSync('adb',a,{encoding:'utf8',shell:false});}
function adbText(...a){const r=adb(...a);return `${r.stdout||''}${r.stderr||''}`;}
function safeName(v){return String(v).replace(/[^a-zA-Z0-9_.-]+/g,'_');}
function write(name,data){fs.writeFileSync(path.join(outDir,name),typeof data==='string'?data:JSON.stringify(data,null,2));}
const logs=[];function log(...p){const s=p.map(v=>typeof v==='string'?v:JSON.stringify(v)).join(' ');console.log(s);logs.push(s);fs.writeFileSync(path.join(outDir,'runner.log'),logs.join('\n'));}
async function shot(name){const r=spawnSync('adb',['exec-out','screencap','-p'],{encoding:null,maxBuffer:64*1024*1024});if(r.status===0&&r.stdout?.length)fs.writeFileSync(path.join(outDir,name),r.stdout);}

function xmlDecode(v=''){return String(v).replace(/&quot;/g,'"').replace(/&apos;/g,"'").replace(/&lt;/g,'<').replace(/&gt;/g,'>').replace(/&amp;/g,'&');}
function parseBounds(s=''){const m=String(s).match(/\[(\d+),(\d+)\]\[(\d+),(\d+)\]/);if(!m)return null;const l=+m[1],t=+m[2],r=+m[3],b=+m[4];return{left:l,top:t,right:r,bottom:b,w:r-l,h:b-t,x:Math.round((l+r)/2),y:Math.round((t+b)/2)};}
function dumpUi(){const remote='/sdcard/fixlgs-mobile-audit.xml';adb('shell','uiautomator','dump','--compressed',remote);return adbText('shell','cat',remote);}
function parseNodes(xml){const out=[];const re=/<node\s+([^>]*?)\/?>(?:<\/node>)?/g;let m;while((m=re.exec(xml||''))){const a={};const ar=/([\w-]+)="([^"]*)"/g;let q;while((q=ar.exec(m[1])))a[q[1]]=xmlDecode(q[2]);out.push(a);}return out;}
function hay(n){return `${n.text||''} ${n['content-desc']||''} ${n['resource-id']||''}`.trim().replace(/\s+/g,' ');}
function isPickerPkg(p=''){return /(photopicker|documentsui|myfiles|gallery|sec\.android\.gallery|providers\.media|intentresolver|resolver)/i.test(p);}
function pickerActive(xml){const ns=parseNodes(xml);return ns.some(n=>isPickerPkg(n.package)) || ns.some(n=>/(사진 선택|사진 또는 동영상|갤러리|photo picker|choose photo|gallery)/i.test(hay(n)) && !/chrome/i.test(n.package||''));}
function mediaCells(xml){
  const ns=parseNodes(xml), seen=new Set(), out=[];
  for(const n of ns){const b=parseBounds(n.bounds);if(!b||n.clickable!=='true'||/chrome/i.test(n.package||''))continue;
    const h=hay(n);const block=/(카메라|camera|갤러리|gallery|사진첩|photos?|컬렉션|collection|완료|done|추가|add|취소|cancel|더보기|more)/i.test(h);
    const media=/(촬영한 사진|photo|image|사진|jpeg|jpg|png|webp)/i.test(h);
    const square=b.w>=180&&b.h>=180&&b.w<=600&&b.h<=600&&b.top>250;
    if(square&&media&&!block&&!seen.has(n.bounds)){seen.add(n.bounds);out.push({n,b,h});}
  }
  out.sort((a,b)=>a.b.top-b.b.top||a.b.left-b.b.left);return out;
}
function clickableByText(xml,patterns){const ns=parseNodes(xml), arr=[];for(const n of ns){if(n.clickable!=='true'||/chrome/i.test(n.package||''))continue;const b=parseBounds(n.bounds);if(!b)continue;const h=hay(n);const ix=patterns.findIndex(re=>re.test(h));if(ix>=0)arr.push({n,b,h,ix});}arr.sort((a,b)=>a.ix-b.ix || a.b.top-b.b.top || a.b.left-b.b.left);return arr;}
async function waitPicker(ms=7000){const st=Date.now();let last='';while(Date.now()-st<ms){last=dumpUi();if(pickerActive(last))return last;await sleep(150);}write(`picker_not_found_${Date.now()}.xml`,last);throw new Error('HARNESS_PICKER_NOT_DETECTED');}
async function ensurePhotoGrid(caseId){
  let xml=await waitPicker();
  for(let step=0;step<6;step++){
    let cells=mediaCells(xml);if(cells.length>=PHOTO_SLOT)return {xml,cells};
    // Follow the actual Samsung/Android chooser state. Do not guess coordinates.
    const nav=clickableByText(xml,[
      /^(사진|사진첩|Photos?|Photo library)$/i,
      /^(갤러리|Gallery)$/i,
      /(사진|사진첩|photo library)/i,
      /(갤러리|gallery)/i,
    ]);
    if(!nav.length){write(`${caseId}_picker_no_grid.xml`,xml);await shot(`${caseId}_picker_no_grid.png`);throw new Error(`HARNESS_PHOTO_GRID_NOT_READY:${cells.length}`);}
    const c=nav[0];log(`[PICKER] ${caseId} -> "${c.h}"`);adb('shell','input','tap',String(c.b.x),String(c.b.y));await sleep(250);xml=await waitPicker(5000);
  }
  throw new Error('HARNESS_PICKER_NAV_EXHAUSTED');
}
async function selectGalleryPhoto(caseId){
  const {xml,cells}=await ensurePhotoGrid(caseId);write(`${caseId}_picker_grid.json`,cells.map((c,i)=>({slot:i+1,bounds:c.n.bounds,label:c.h})));write(`${caseId}_picker_grid.xml`,xml);
  const c=cells[PHOTO_SLOT-1];if(!c)throw new Error(`HARNESS_PHOTO_SLOT_MISSING:${PHOTO_SLOT}`);
  adb('shell','input','tap',String(c.b.x),String(c.b.y));log(`[PHOTO] ${caseId} -> 갤러리 ${PHOTO_SLOT}번째 실사진`);
  const end=Date.now()+7000;let committed=false;
  while(Date.now()<end){await sleep(120);const x=dumpUi();if(!pickerActive(x))return;
    if(!committed){const a=clickableByText(x,[/^(완료|추가|열기|확인|Done|Add|Open|Choose)$/i]);if(a.length){adb('shell','input','tap',String(a[0].b.x),String(a[0].b.y));committed=true;}}
  }
  throw new Error('HARNESS_PICKER_DID_NOT_RETURN');
}

async function resolveUploadControl(page,inputSel){
  const input=page.locator(inputSel).first();
  await input.waitFor({state:'attached',timeout:12000});
  const handle=await input.evaluateHandle(el=>{
    const visible=n=>{if(!n)return false;const r=n.getBoundingClientRect();const cs=getComputedStyle(n);return r.width>8&&r.height>8&&cs.display!=='none'&&cs.visibility!=='hidden'&&Number(cs.opacity||1)!==0;};
    if(el.id){
      const labels=[...document.querySelectorAll('label')].filter(x=>x.htmlFor===el.id&&visible(x));
      if(labels.length)return labels[0];
    }
    let n=el.parentElement;
    while(n){
      if(visible(n) && (n.matches('label,button,[role="button"]') || getComputedStyle(n).cursor==='pointer')) return n;
      n=n.parentElement;
    }
    return visible(el)?el:null;
  });
  const control=handle.asElement();
  if(!control){await handle.dispose().catch(()=>{});throw new Error('HARNESS_VISIBLE_UPLOAD_CONTROL_NOT_FOUND');}
  const desc=await control.evaluate(el=>({
    tag:el.tagName,
    id:el.id||'',
    testid:el.getAttribute('data-testid')||'',
    text:(el.textContent||'').trim().replace(/\s+/g,' ').slice(0,160),
    rect:(()=>{const r=el.getBoundingClientRect();return{x:r.x,y:r.y,width:r.width,height:r.height};})(),
  }));
  return {control,desc};
}
async function openPicker(page,context,tool,caseId,inputSel){
  const {control,desc}=await resolveUploadControl(page,inputSel);
  write(`${caseId}_upload_target.json`,desc);
  log(`[UPLOAD] ${caseId} -> ${desc.tag}${desc.testid?` [${desc.testid}]`:''}${desc.text?` "${desc.text.slice(0,80)}"`:''}`);
  await control.scrollIntoViewIfNeeded().catch(()=>{});
  // One real trusted browser click. No coordinate guessing and no retry chain.
  await control.click({timeout:6000});
  const xml=await waitPicker(6500);
  write(`${caseId}_picker_open.xml`,xml);
  log(`[PICKER] ${caseId} OPEN CONFIRMED`);
}

async function baseline(page){return page.evaluate(()=>({
  imgs:[...document.images].filter(i=>i.complete&&i.naturalWidth>0).length,
  canvases:[...document.querySelectorAll('canvas')].filter(c=>c.width>0&&c.height>0).length,
  signals:document.querySelectorAll('[data-testid*="file-card"],[data-testid*="file-item"],[data-testid*="preview"],[data-testid*="filename"],[data-testid*="layer"]').length,
  text:(document.body?.innerText||'').length,
}));}
async function visibleAny(page,selectors){for(const s of selectors||[]){try{const l=page.locator(s).first();if(await l.count()&&await l.isVisible())return s;}catch{}}return null;}
async function stateDelta(page,b){return page.evaluate(base=>{
  const imgs=[...document.images].filter(i=>i.complete&&i.naturalWidth>0).length;
  const canvases=[...document.querySelectorAll('canvas')].filter(c=>c.width>0&&c.height>0).length;
  const signals=document.querySelectorAll('[data-testid*="file-card"],[data-testid*="file-item"],[data-testid*="preview"],[data-testid*="filename"],[data-testid*="layer"]').length;
  const alerts=[...document.querySelectorAll('[role="alert"]')].map(x=>(x.textContent||'').trim()).filter(Boolean);
  return{imgs,canvases,signals,alerts,changed:imgs>base.imgs||canvases>base.canvases||signals>base.signals};
},b);}
async function waitAttach(page,tool,b,caseId){
  const start=Date.now();while(Date.now()-start<SAFETY_ATTACH_MS){const exact=await visibleAny(page,tool.attach);const d=await stateDelta(page,b);if(exact||d.changed)return{exact,delta:d,ms:Date.now()-start};if(d.alerts.length) return {error:d.alerts.join(' | '),delta:d,ms:Date.now()-start};await sleep(100);}const d=await stateDelta(page,b);return{timeout:true,delta:d,ms:Date.now()-start};
}
async function immediateScroll(page){await page.evaluate(px=>window.scrollBy({top:px,left:0,behavior:'instant'}),SCROLL_PX);}
async function findAction(page,action){
  if(!action)return null;
  if(typeof action==='string'){const l=page.locator(action).first();if(await l.count()&&await l.isVisible()&&await l.isEnabled())return l;return null;}
  const bs=page.getByRole('button');const n=await bs.count();for(let i=0;i<n;i++){const b=bs.nth(i);if(!(await b.isVisible().catch(()=>false))||!(await b.isEnabled().catch(()=>false)))continue;const txt=(await b.innerText().catch(()=>'' )).trim();if(action.test(txt))return b;}return null;
}
async function waitResult(page,tool,caseId){
  const start=Date.now();while(Date.now()-start<SAFETY_RESULT_MS){const s=await visibleAny(page,tool.result);if(s){let enabled=true;try{const l=page.locator(s).first();if(await l.evaluate(el=>['BUTTON','INPUT'].includes(el.tagName)))enabled=await l.isEnabled();}catch{}if(enabled)return{selector:s,ms:Date.now()-start};}const alerts=await page.locator('[role="alert"]').allInnerTexts().catch(()=>[]);if(alerts.filter(Boolean).length)return{error:alerts.join(' | '),ms:Date.now()-start};await sleep(100);}return{timeout:true,ms:Date.now()-start};
}

async function runCase(page,context,tool,round){
  const caseId=`T${tool.number}_R${round}`;const url=`${BASE}/${LOCALE}/${tool.slug}`;const started=Date.now();
  log(`\n[${tool.number}] ROUND ${round} START  ${url}`);
  try{
    await page.goto(url,{waitUntil:'domcontentloaded',timeout:30000});
    await page.locator(tool.input).first().waitFor({state:'attached',timeout:12000});
    const base=await baseline(page);
    const uploadSelectors=tool.uploadSelectors||Array.from({length:tool.uploads},()=>tool.input);
    for(let u=0;u<uploadSelectors.length;u++){
      const sel=uploadSelectors[u];const cid=`${caseId}_U${u+1}`;
      log(`[${tool.number}] upload ${u+1}/${uploadSelectors.length}`);
      await openPicker(page,context,tool,cid,sel);
      await selectGalleryPhoto(cid);
      // User-observed real flow: attachment settles after a small scroll. No fixed 5-second wait.
      await immediateScroll(page);
      const a=await waitAttach(page,tool,base,cid);
      write(`${cid}_attach.json`,a);
      if(a.error||a.timeout){await shot(`${cid}_attach_fail.png`);return result(tool,round,'PRODUCT_FAIL','ATTACH',a.error||'attachment state not reached',started,{attach:a});}
    }
    const action=await findAction(page,tool.action);
    if(action){await action.scrollIntoViewIfNeeded().catch(()=>{});await action.click({timeout:6000});log(`[${tool.number}] PROCESS action clicked`);}
    const rr=await waitResult(page,tool,caseId);write(`${caseId}_result.json`,rr);
    if(rr.error||rr.timeout){await shot(`${caseId}_result_fail.png`);return result(tool,round,'PRODUCT_FAIL','RESULT',rr.error||'result-ready state not reached',started,{result:rr});}
    log(`[${tool.number}] PASS  ${(Date.now()-started)/1000}s`);return result(tool,round,'PASS','DONE','',started,{result:rr});
  }catch(e){
    const msg=String(e?.message||e);const harness=/HARNESS_|PICKER_|NO_ANDROID|VISIBLE_UPLOAD_CONTROL|PHOTO_GRID|PHOTO_SLOT|uiautomator/i.test(msg);
    await shot(`${caseId}_${harness?'harness':'product'}_fail.png`).catch(()=>{});
    log(`[${tool.number}] ${harness?'HARNESS_FAIL':'PRODUCT_FAIL'} ${msg}`);
    return result(tool,round,harness?'HARNESS_FAIL':'PRODUCT_FAIL',harness?'HARNESS':'EXCEPTION',msg,started,{});
  }
}
function result(tool,round,status,stage,message,started,extra){return{tool:tool.number,slug:tool.slug,round,status,stage,message,elapsedMs:Date.now()-started,...extra};}

let context;
try{
  log('FIXLGS TOOLBOX MOBILE REAL-PHOTO VALIDATOR');
  log(`Target: ${TOOLS.map(t=>t.number).join(', ')}`);
  log(`Photo: gallery slot ${PHOTO_SLOT} (user-confirmed real car photo)`);
  log('Flow: select -> immediate small scroll -> wait for UI state -> process/result');
  log(`Retest: ${RETEST?'PRODUCT_FAIL only, once':'disabled'}`);
  log('');
  const state=adbText('devices');write('adb-devices.txt',state);if(!/\tdevice\b/.test(state))throw new Error('HARNESS_NO_ANDROID_DEVICE');
  const devices=await android.devices();if(!devices.length)throw new Error('HARNESS_NO_PLAYWRIGHT_ANDROID_DEVICE');
  const device=devices[0];context=await device.launchBrowser({});const pages=context.pages();const page=pages[0]||await context.newPage();
  const first=[];
  for(let i=0;i<TOOLS.length;i++){log(`[PROGRESS ${i+1}/${TOOLS.length}] TOOL ${TOOLS[i].number}`);first.push(await runCase(page,context,TOOLS[i],1));}
  const retryTargets=RETEST?first.filter(r=>r.status==='PRODUCT_FAIL'&&r.tool!=='018').map(r=>TOOLS.find(t=>t.number===r.tool)).filter(Boolean):[];
  const second=[];
  if(retryTargets.length){log(`\n[RETEST] PRODUCT_FAIL ${retryTargets.map(t=>t.number).join(', ')} -> independent one-time retest`);for(let i=0;i<retryTargets.length;i++)second.push(await runCase(page,context,retryTargets[i],2));}
  const final=TOOLS.map(tool=>{const a=first.find(r=>r.tool===tool.number),b=second.find(r=>r.tool===tool.number);let verdict=(tool.number==='018'&&a.status!=='PASS')?'TOOL018_SPECIAL_FAIL':a.status;if(tool.number!=='018'&&a.status==='PRODUCT_FAIL'&&b?.status==='PASS')verdict='FLAKY';else if(tool.number!=='018'&&a.status==='PRODUCT_FAIL'&&b?.status==='PRODUCT_FAIL')verdict='PRODUCT_FAIL';else if(tool.number!=='018'&&a.status==='PRODUCT_FAIL'&&b?.status==='HARNESS_FAIL')verdict='PRODUCT_FAIL_RETEST_INVALID';return{tool:tool.number,slug:tool.slug,first:a.status,retest:b?.status||'',verdict,firstStage:a.stage,retestStage:b?.stage||'',message:b?.message||a.message||''};});
  const summary={createdAt:new Date().toISOString(),baseUrl:BASE,locale:LOCALE,photoSlot:PHOTO_SLOT,firstPass:first,retest:second,final,counts:{pass:final.filter(x=>x.verdict==='PASS').length,flaky:final.filter(x=>x.verdict==='FLAKY').length,productFail:final.filter(x=>x.verdict.startsWith('PRODUCT_FAIL')).length,harnessFail:final.filter(x=>x.verdict==='HARNESS_FAIL').length,tool018SpecialFail:final.filter(x=>x.verdict==='TOOL018_SPECIAL_FAIL').length}};
  write('summary.json',summary);write('summary.tsv',['TOOL\tFIRST\tRETEST\tFINAL\tSTAGE\tMESSAGE',...final.map(x=>`${x.tool}\t${x.first}\t${x.retest}\t${x.verdict}\t${x.retestStage||x.firstStage}\t${String(x.message).replace(/[\t\r\n]+/g,' ')}`)].join('\n'));
  log('\n================ FINAL ================');for(const x of final)log(`TOOL${x.tool}  ${x.verdict}${x.retest?`  (${x.first} -> ${x.retest})`:''}`);log('---------------------------------------');log(`PASS ${summary.counts.pass} | FLAKY ${summary.counts.flaky} | PRODUCT_FAIL ${summary.counts.productFail} | HARNESS_FAIL ${summary.counts.harnessFail} | TOOL018_SPECIAL_FAIL ${summary.counts.tool018SpecialFail}`);log(`RESULT: ${outDir}`);
  process.exitCode=summary.counts.productFail?1:0;
}catch(e){log(`[FATAL HARNESS] ${String(e?.stack||e)}`);process.exitCode=2;}finally{if(context)await context.close().catch(()=>{});}
